# ==========================================
# Alaktra Music Server Configuration
# ==========================================

# Port and Host
PORT=8000
HOST=0.0.0.0

# ------------------------------------------
# Gmail SMTP Configuration for sending OTPs
# ------------------------------------------
# 1. GMAIL_USER: Your Gmail address (sender)
GMAIL_USER=alaktracare@gmail.com

# 2. GMAIL_APP_PASSWORD: Your 16-character Google App Password
# Generate one at: https://myaccount.google.com/apppasswords
# NOTE: Do NOT use your regular Google login password!
# Example format: abcd efgh ijkl mnop
GMAIL_APP_PASSWORD=your_16_char_app_password_here
