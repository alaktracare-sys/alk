# ==========================================
# Alaktra Music Server Configuration
# ==========================================

# Port and Host
PORT=8000
HOST=0.0.0.0

# Security Keys for App Request Verification (Solution 1 & Solution 2)
API_SECRET=alaktra_secure_app_secret_998877
HMAC_SECRET=alaktra_hmac_secret_key_334455

# ------------------------------------------
# Gmail SMTP Configuration for sending OTPs
# ------------------------------------------
# 1. GMAIL_USER: Your Gmail address (sender)
GMAIL_USER=alaktracare@gmail.com

# 2. GMAIL_APP_PASSWORD: Your 16-character Google App Password
# Generate one at: https://myaccount.google.com/apppasswords
# NOTE: Do NOT use your regular Google login password!
# Example format: abcd efgh ijkl mnop
GMAIL_APP_PASSWORD=your_16_char_app_password_here

# ------------------------------------------
# Admin Console (http://localhost:8080)
# ------------------------------------------
# Change the password! With the factory password (admin123) the console only
# listens on this computer; with your own password it also listens on the LAN /
# Tailscale. Run it with:  python launcher.py
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
ADMIN_PORT=8080
# ADMIN_HOST=127.0.0.1         # force local-only (or 0.0.0.0 for all interfaces)
# ADMIN_MAX_UPLOAD_MB=300
# KEEP_API_ON_EXIT=1           # keep the API running when you quit the console

# Cloudflare tunnel started by the power button (needs `cloudflared` installed)
CF_TUNNEL_NAME=alaktra
CF_HOST_DOMAIN=api.alaktracare.in
